# Ключи и секреты — никогда не коммитить.
# В .env лежит youtubeApiKey для скрипта tools/update-views.ps1.
.env

# Служебное
.DS_Store
Thumbs.db
*.bak

# Страницы для поисковиков — их собирает build/prerender.py при каждом
# деплое из data/*.json. В репозитории им делать нечего: держать копию
# рядом с исходником значит однажды выложить устаревшую. Появляются здесь
# только после локального прогона генератора.
/episodes/
/merch/
/episode/
/robots.txt
/sitemap.xml
